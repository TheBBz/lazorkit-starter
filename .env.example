# Lazorkit SDK Configuration
# Copy this file to .env.local and update the values as needed

# Solana RPC endpoint
# Default: Solana Devnet
# For production, use a dedicated RPC provider (Helius, QuickNode, etc.)
NEXT_PUBLIC_LAZORKIT_RPC_URL=https://api.devnet.solana.com

# Lazorkit Portal URL for passkey authentication
# This is the hosted service that handles WebAuthn/passkey flows
NEXT_PUBLIC_LAZORKIT_PORTAL_URL=https://portal.lazor.sh

# Lazorkit Paymaster URL for gasless transactions
# The paymaster sponsors transaction fees, allowing gasless UX
# Kora is the official paymaster service for Lazorkit
NEXT_PUBLIC_LAZORKIT_PAYMASTER_URL=https://kora.devnet.lazorkit.com

# =============================================================================
# tUSDC (Test USDC) Token Configuration
# These are generated by running: npx tsx scripts/deploy-tusdc.ts
# =============================================================================

# tUSDC mint address on devnet (your deployed token)
TUSDC_MINT_ADDRESS=

# Pool wallet public key (holds tUSDC liquidity)
TUSDC_POOL_WALLET=

# Pool token account (ATA for tUSDC)
TUSDC_POOL_TOKEN_ACCOUNT=

# Mint authority keypair (base64 encoded, for future minting)
TUSDC_MINT_AUTHORITY=

# Pool wallet keypair (base64 encoded, for swap transfers)
TUSDC_POOL_KEYPAIR=

# Public config (accessible in frontend)
NEXT_PUBLIC_TUSDC_MINT_ADDRESS=
NEXT_PUBLIC_TUSDC_POOL_WALLET=
